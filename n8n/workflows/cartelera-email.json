        "jsCode": "let rows = \"\";\n\n// Recorremos todos los ítems que vienen de la API\nfor (const item of $input.all()) {\n  const p = item.json;\n  rows += `\n    <tr>\n      <td style=\"padding: 8px; border: 1px solid #ddd;\"><b>${p.titulo}</b></td>\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">${p.num_cines || 0} cines</td>\n      <td style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">\n        <a href=\"${p.url_ficha}\">Ver ficha</a>\n      </td>\n    </tr>`;\n}\n\nreturn {\n  html_tabla: `\n    <h2>🎬 Cartelera de Madrid - Recomendaciones</h2>\n    <p>Aquí tienes las películas destacadas para esta semana:</p>\n    <table style=\"width:100%; border-collapse: collapse;\">\n      <thead>\n        <tr style=\"background-color: #f2f2f2;\">\n          <th style=\"padding: 8px; border: 1px solid #ddd;\">Título</th>\n          <th style=\"padding: 8px; border: 1px solid #ddd;\">Cines</th>\n          <th style=\"padding: 8px; border: 1px solid #ddd;\">Enlace</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${rows}\n      </tbody>\n    </table>\n    <p style=\"font-size: 0.8em; color: grey;\">Fuente: ecartelera.com</p>`\n};"
      },
