# ============================================================
# .env.example  –  Copia esto a .env y rellena tus valores
# ============================================================

# ── OMDB API (fallback si Playwright falla) ──────────────────────────────────
# API key gratuita: https://www.omdbapi.com/apikey.aspx (1000 peticiones/día)
# Si no la configuras, el sistema solo usará scraping Playwright
OMDB_API_KEY=tu_omdb_api_key_aqui

# ── TELEGRAM ─────────────────────────────────────────────────
# Token del bot (obtenido de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=8506521289:AAEt6TURz2qwYa91mXHqnqAmh5RfSlsxhow

# Chat ID al que enviar los mensajes de la cartelera automática
# Para obtenerlo: envía un mensaje al bot y visita:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ── OLLAMA ───────────────────────────────────────────────────
# URL de tu instancia de Ollama
# Si está en tu máquina local: http://localhost:11434
# Si está en otra máquina de tu red/VPN: http://192.168.1.x:11434 o http://100.x.x.x:11434
OLLAMA_URL=http://localhost:11434

# Modelo a usar en Ollama (debe estar descargado)
# Recomendados para generar código: qwen2.5-coder:7b, codellama:7b, deepseek-coder:6.7b
# Recomendados para interpretar texto: llama3.2:3b, mistral:7b
OLLAMA_MODEL=qwen2.5-coder:7b

# ── API SERVER (para Alexa) ───────────────────────────────────
# URL donde corre api_server.py (accesible desde AWS Lambda)
# Si usas Tailscale: http://100.x.x.x:8080
# Si usas ngrok: https://xxxx.ngrok.io
MOVIE_API_URL=http://TU_IP_TAILSCALE:8080
